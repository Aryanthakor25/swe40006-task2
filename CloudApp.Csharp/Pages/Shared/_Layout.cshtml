<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SWE40006 Cloud App</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header>
        <div class="wrap">
            <strong>SWE40006 &mdash; Task 2 Cloud App (.NET 8)</strong>
            <nav>
                <a asp-page="/Index">Home</a>
                <a asp-page="/Config">Configuration</a>
                <a href="/health">Health</a>
            </nav>
        </div>
    </header>

    <main class="wrap">
        @RenderBody()
    </main>

    <footer>
        <div class="wrap">
            Served by <code>@Environment.MachineName</code> &middot; @DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss") UTC
        </div>
    </footer>
</body>
</html>
